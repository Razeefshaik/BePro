# Variable names only. Real values go in .env, which is never committed.
# LLM_PROVIDER: "openai" (default) or "codex".
#   openai: any OpenAI compatible chat completions endpoint (Groq, OpenRouter, Ollama...).
#   codex:  runs the local Codex CLI (`codex exec`), for development only. Needs `codex login`.
LLM_PROVIDER=openai
LLM_TIMEOUT_MS=25000
CODEX_MODEL=gpt-6-luna
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=
PORT=8787
