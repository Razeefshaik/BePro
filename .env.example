# Copy this file to .env and fill it in. .env is never committed.

# Which model backend the server uses:
#   openai  any OpenAI compatible chat completions endpoint (Groq, OpenRouter, Ollama, OpenAI...)
#   codex   the local Codex CLI (`codex exec`), for development. Needs `codex login`.
#   mock    canned replies, no network and no key. Good for trying the UI.
LLM_PROVIDER=openai

# openai mode. Example for Groq's free tier:
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Set to true if your provider supports response_format json_object (Groq, OpenAI, Ollama do).
LLM_JSON_MODE=false
# Ollama example: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1  (no key needed)

# codex mode
CODEX_MODEL=gpt-6-luna

# Time limit for ONE model call, in ms. Default 25000 (120000 for codex). There are at most 2 calls per request.
LLM_TIMEOUT_MS=

# 0 to 1: share of model replies broken on purpose (fenced, truncated, empty, bad index, slow),
# to watch the failure handling work. Keep 0 for normal use.
LLM_CHAOS=0

PORT=8787
